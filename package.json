{
  "name": "cocoa-caramel",
  "version": "1.0.0",
  "description": "Cocoa Caramel — dessert, chocolate gifting and catering e-commerce",
  "main": "src/server.js",
  "scripts": {
    "setup": "node scripts/build-media.mjs && node --disable-warning=ExperimentalWarning scripts/seed.js",
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "build:media": "node scripts/build-media.mjs",
    "admin:create": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "e2e": "node --disable-warning=ExperimentalWarning scripts/e2e.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "sharp": "^0.35.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
