# ---- Server ---------------------------------------------------------------
# Long random string (e.g. `openssl rand -hex 32`). Rotating it signs out the admin team and
# invalidates the private links already sent by email.
SESSION_SECRET=
# Postgres connection string. On Vercel, connecting a Neon database sets this for you.
# Leave empty locally to use the embedded database in ./data.
DATABASE_URL=
# Public https address (defaults to the Vercel production URL). Used for payment callbacks,
# redirects and links in emails.
BASE_URL=
# One-time code for creating the first owner account at /admin/setup. Remove after use.
ADMIN_SETUP_TOKEN=

# ---- Payments --------------------------------------------------------------
# test = simulated sandbox (or Paymob test keys); live = real money (Paymob live keys + https)
PAYMENT_MODE=test
# sandbox (built-in simulator, test mode only) or paymob
PAYMENT_PROVIDER=sandbox

# Paymob (Egypt) — from the Paymob dashboard
PAYMOB_BASE_URL=https://accept.paymob.com/
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated integration IDs (card, wallets, etc.) shown on the hosted checkout
PAYMOB_INTEGRATION_IDS=

# ---- Email notifications ----------------------------------------------------
# e.g. smtps://user:pass@smtp.example.com:465 — leave blank to record messages in the admin only
SMTP_URL=
MAIL_FROM="Cocoa Caramel <hello@example.com>"
