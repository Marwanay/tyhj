# ---- Server ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Public https address of the site (used for payment callbacks, redirects and email links)
BASE_URL=https://www.example.com
# Long random string (e.g. `openssl rand -hex 32`). Rotating it invalidates admin sessions
# and the private links shown in emails.
SESSION_SECRET=
# Where the SQLite database and private uploads live (must be on persistent storage)
DATA_DIR=./data
# Set when running behind a reverse proxy / load balancer (number of hops)
TRUST_PROXY=1

# ---- Payments --------------------------------------------------------------
# test = sandbox or Paymob test keys; live = real money (requires Paymob live keys + https BASE_URL)
PAYMENT_MODE=test
# sandbox (built-in simulator, test mode only) or paymob
PAYMENT_PROVIDER=sandbox

# Paymob (Egypt) — Dashboard → Settings / Developers
PAYMOB_BASE_URL=https://accept.paymob.com/
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated integration IDs (card, wallets, etc.) that should appear on the hosted checkout
PAYMOB_INTEGRATION_IDS=

# ---- Email notifications ----------------------------------------------------
# e.g. smtps://user:pass@smtp.example.com:465 — leave blank to log messages in the admin only
SMTP_URL=
MAIL_FROM="Cocoa Caramel <hello@example.com>"
